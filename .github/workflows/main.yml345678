# FILE: .github/workflows/main.yml

name: Build Tweak

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Source
      uses: actions/checkout@v3

    - name: Set up Theos Environment
      uses: sbingner/setup-theos@v1
      with:
        theos-src: https://github.com/theos/theos.git
        theos-ref: master

    - name: Compile SDK Check
      run: |
        mkdir -p $THEOS/sdks
        curl -L https://github.com/theos/sdks/raw/master/iPhoneOS16.5.sdk.tar.xz | tar -xJ -C $THEOS/sdks

    - name: Build Tweak Package
      run: |
        make package FINALPACKAGE=1

    - name: Upload Finished Release
      uses: actions/upload-artifact@v3
      with:
        name: ScreenFlash-Tweak
        path: packages/*.deb
